// Campaignly.AI POC data model
// Production target per scope: MongoDB + Mongoose. SQLite used here for zero-config local demos.
// Enum-like values stored as strings for SQLite compatibility.

generator client {
  provider      = "prisma-client-js"
  // native = local; rhel-openssl-3.0.x = Vercel serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("OWNER") // OWNER | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       BusinessProfile?
  creatives      AdCreative[]
  mediaAssets    MediaAsset[]
  campaigns      Campaign[]
  leads          Lead[]
  conversations  WhatsAppConversation[]
  subscription   Subscription?
  notifications  Notification[]
  metaConnection MetaConnection?
}

model BusinessProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  businessName        String
  industry            String
  category            String?
  brandTone           String   @default("professional")
  communicationStyle  String   @default("friendly")
  targetAudience      String?
  website             String?
  location            String?
  services            String?
  brandColors         String?
  logoUrl             String?
  onboardingStep      Int      @default(1)
  onboardingComplete  Boolean  @default(false)
  aiRecommendations   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdCreative {
  id               String   @id @default(cuid())
  userId           String
  headline         String
  primaryText      String
  description      String?
  cta              String   @default("Learn More")
  variations       String?
  audienceConfig   String?
  complianceScore  Int      @default(85)
  complianceNotes  String?
  status           String   @default("draft")
  templateId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
}

model MediaAsset {
  id               String   @id @default(cuid())
  userId           String
  parentId         String?
  filename         String
  mimeType         String
  mediaType        String
  url              String
  storageKey       String?
  width            Int?
  height           Int?
  durationSec      Int?
  brandApplied     Boolean  @default(false)
  captions         String?
  captionTrackUrl  String?
  placement        String?
  source           String   @default("upload") // upload | resize | brand | caption | snippet | enhance | manual_edit
  processingStatus String   @default("ready") // ready | processing | failed
  notes            String?
  createdAt        DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    MediaAsset?  @relation("MediaVariants", fields: [parentId], references: [id], onDelete: SetNull)
  variants  MediaAsset[] @relation("MediaVariants")
  campaigns Campaign[]
}

model MetaConnection {
  id             String    @id @default(cuid())
  userId         String    @unique
  status         String    @default("DISCONNECTED") // CONNECTED | RECONNECT_REQUIRED | DISCONNECTED
  adAccountId    String?
  pageId         String?
  tokenPreview   String?
  adAccountsJson String?
  pagesJson      String?
  connectedAt    DateTime?
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id                  String    @id @default(cuid())
  userId              String
  adCreativeId        String?
  mediaAssetId        String?
  name                String
  objective           String    @default("LEADS") // AWARENESS | TRAFFIC | ENGAGEMENT | LEADS | APP_PROMOTION | SALES
  status              String    @default("DRAFT") // DRAFT | PENDING_REVIEW | ACTIVE | PAUSED | STOPPED | REJECTED
  localStatus         String    @default("DRAFT") // DRAFT | READY | SUBMITTED | FAILED
  metaStatus          String? // PENDING_REVIEW | ACTIVE | PAUSED | STOPPED | REJECTED
  metaReviewReason    String?
  budgetType          String    @default("DAILY") // DAILY | LIFETIME
  dailyBudget         Float     @default(20)
  totalBudget         Float?
  scheduleStart       DateTime?
  scheduleEnd         DateTime?
  targeting           String?
  specialAdCategory   String? // NONE | HOUSING | EMPLOYMENT | CREDIT (POLITICAL rejected)
  resolvedLocation    String?
  locationConfirmedAt DateTime?
  placements          String? // JSON: feed_square | story_reels | landscape
  metaCampaignId      String?
  metaAdSetId         String?
  metaAdId            String?
  metaAdAccountId     String?
  facebookPageId      String?
  impressions         Int       @default(0)
  clicks              Int       @default(0)
  conversions         Int       @default(0)
  spend               Float     @default(0)
  metricsAvailable    Boolean   @default(false)
  lastSyncedAt        DateTime?
  lastSyncError       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  adCreative AdCreative? @relation(fields: [adCreativeId], references: [id])
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  leads      Lead[]
}

model Lead {
  id              String   @id @default(cuid())
  userId          String
  campaignId      String?
  name            String
  email           String?
  phone           String?
  source          String   @default("meta_lead_form")
  status          String   @default("NEW") // NEW | CONTACTED | NURTURING | QUALIFIED | CONVERSION_READY | CONVERTED | LOST
  score           Int      @default(0)
  category        String?
  notes           String?
  engagementLevel String   @default("low")
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign     Campaign?             @relation(fields: [campaignId], references: [id])
  conversation WhatsAppConversation?
}

model WhatsAppConversation {
  id                 String   @id @default(cuid())
  userId             String
  leadId             String   @unique
  status             String   @default("AI_ACTIVE") // AI_ACTIVE | MANUAL | CLOSED
  leadScore          Int      @default(0)
  sentiment          String   @default("neutral") // positive | neutral | negative
  intent             String   @default("unknown") // purchase_ready | pricing | scheduling | information | objection | rejection | unknown
  intentConfidence   Int      @default(0)
  scoringBreakdown   String?  // JSON: signals + contribution breakdown
  readyForConversion Boolean  @default(false)
  escalateToOwner    Boolean  @default(false)
  followUpDelayHours Int      @default(24)
  lastMessageAt      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String
  sender         String
  content        String
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("TRIAL") // TRIAL | STARTER | PRO | AGENCY
  status               String    @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELED
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  source    String   @default("contact")
  createdAt DateTime @default(now())
}

model DiagnosticResult {
  id              String   @id @default(cuid())
  businessName    String
  industry        String
  email           String
  monthlySpend    Float?
  score           Int
  recommendations String
  createdAt       DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ReferralCampaign {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  channel   String
  clicks    Int      @default(0)
  signups   Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
