# Environment
DATABASE_URL="file:./dev.db"
JWT_SECRET="campaignly-poc-dev-secret-change-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Module 1–2 live AI — Gemini primary, Groq secondary fallback
USE_MOCK_AI="false"
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-20b"

# Module 3 — Whisper captions (optional; falls back to Gemini/Groq/mock)
OPENAI_API_KEY=""

# Module 3 — media storage (USE_MOCK_S3=true uses public/uploads locally)
USE_MOCK_S3="true"
MEDIA_LOCAL_DIR="public/uploads"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# S3_BUCKET=""
# S3_PUBLIC_BASE_URL=""

USE_MOCK_META="true"
USE_MOCK_STRIPE="true"
USE_MOCK_WHATSAPP="true"
