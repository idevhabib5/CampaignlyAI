# Environment
# Local + Vercel POC: SQLite file (relative to /prisma). On Vercel, the app copies it to /tmp at runtime.
DATABASE_URL="file:./dev.db"
JWT_SECRET="campaignly-poc-dev-secret-change-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel: set these in Project → Settings → Environment Variables
# DATABASE_URL=file:./dev.db
# JWT_SECRET=<long-random-string>
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Mock integrations (set USE_MOCK_*=false when real credentials are available)
USE_MOCK_AI="true"
USE_MOCK_META="true"
USE_MOCK_STRIPE="true"
USE_MOCK_WHATSAPP="true"
USE_MOCK_S3="true"

# Optional real credentials (unused while mocks are enabled)
# OPENAI_API_KEY=
# META_APP_ID=
# META_APP_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
